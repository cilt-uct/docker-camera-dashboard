# Example .env for docker-camera-dashboard
# Values are examples — do not commit secrets to source control.

# General
ENV=dev
DEBUG=true
RUNNING_IN_DOCKER=true
ROOT_PATH=/cams

# Redis
REDIS_HOST=redis
REDIS_PORT=6379
# REDIS_PASSWORD is typically provided via a Docker secret (see secrets/)

# Opencast (optional)
OC_SERVER=http://opencast.example.local
OC_USER=your_opencast_user
OC_PASS=your_opencast_password

# Storage
IMAGE_DIR=/shared_volume/images
TIMELAPSE_DIR=/shared_volume/timelapse

# Intervals (seconds) - 300 = 5 minutes, 900 = 15 minutes, 604800 = 7 days
CAPTURE_INTERVAL=300
TIMELAPSE_INTERVAL=900
CLEAN_INTERVAL=604800

# Batching
BATCH_SIZE=5
BATCH_DELAY=10
