# Example passwords file (env format) used by services via Docker secrets
# Copy to /usr/local/serverconfig/camera_dashboard.cfg or point your secret to this file

OC_SERVER=http://opencast.example.local
OC_USER=opencast_user
OC_PASS=opencast_password

# Add additional sensitive variables as required
# e.g., OTHER_SECRET=supersecretvalue

MYSQL_HOST=server
MYSQL_DB=database
MYSQL_USER=user
MYSQL_PASSWORD=password
MYSQL_PORT=3306

REDIS_PORT=6379

PYCA_PAGE_URL="https://pycas.server.list"

# Storage
IMAGE_DIR=/shared_volume/images
TIMELAPSE_DIR=/shared_volume/timelapse

# Intervals (seconds) - 300 = 5 minutes, 900 = 15 minutes, 1200 = 20 minutes, 604800 = 7 days
CAPTURE_INTERVAL=300
STATUS_INTERVAL=1200
TIMELAPSE_INTERVAL=900
CLEAN_INTERVAL=604800

# Batching
BATCH_SIZE=10
BATCH_DELAY=10

CONTACT_EMAIL=helpdesk@example.com
